# ─────────────────────────────────────────────────────────────
#  NexaLM — environment template
#  Copy to .env and fill in every CHANGE_ME.  NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# docker-compose.yml starts Postgres as `db` with this password.
# Keep it identical to the password inside DATABASE_URL.
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://localllm_user:CHANGE_ME@db:5432/localllm
DB_POOL_MAX=10

# ── API server ──────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
# Public origin, used for cookie/CORS decisions
PUBLIC_ORIGIN=https://chat.example.com

# ── Application access gate ─────────────────────────────────
# Single shared passphrase for this private deployment.
# Replaced by real auth later; the session seam already exists.
APP_ACCESS_TOKEN=CHANGE_ME_APP_ACCESS
# Secret used to sign the access + session cookies (min 32 chars)
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET_MIN_32_CHARS_LONG

# ── Worker authentication ───────────────────────────────────
# Bearer token every inference worker must present on WS connect.
WORKER_TOKEN=CHANGE_ME_WORKER_TOKEN

# ── Worker lease / heartbeat (milliseconds) ─────────────────
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_LEASE_TIMEOUT_MS=30000
WORKER_SWEEP_INTERVAL_MS=5000

# ── Inference defaults ──────────────────────────────────────
DEFAULT_MODEL=qwen3-30b-a3b
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_MAX_TOKENS=2048
DEFAULT_CONTEXT_LENGTH=16384
JOB_TIMEOUT_MS=600000

# ── Web container ───────────────────────────────────────────
WEB_PORT=8081

# ── Accounts ────────────────────────────────────────────────
# Open registration. Turn off once the people who need accounts have them.
SIGNUP_ENABLED=true

# An extra shared-secret gate in front of the login screen. Off by default;
# turning it on with an empty APP_ACCESS_TOKEN refuses to start rather than
# locking everyone out silently.
REQUIRE_ACCESS_TOKEN=false

SESSION_TTL_DAYS=30

# ── Google sign-in (optional) ───────────────────────────────
# All three must be set or the button is hidden. The redirect URI must match
# the one registered in the Google Cloud console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://chat.example.com/api/auth/google/callback

# ── Outbound mail ───────────────────────────────────────────
# Sign-up asks for an emailed code only when SMTP_PASS is filled in: demanding
# a code the server cannot send would lock everybody out. Gmail needs a
# 16-character App Password -- it rejects account passwords for SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NexaLM <you@example.com>

# Addresses on these domains skip verification. Not a convenience switch:
# .local is reserved and cannot receive mail at all, so requiring a code there
# would make sign-up impossible rather than slower. It is what lets the
# end-to-end test harness create the throwaway accounts it needs.
OTP_EXEMPT_DOMAINS=nexalm.local

# Credentials the harness signs in with. Any address on an exempt domain.
E2E_EMAIL=e2e-primary@nexalm.local
E2E_PASSWORD=
E2E_ALT_EMAIL=e2e-secondary@nexalm.local
E2E_ALT_PASSWORD=

# ── Web search ──────────────────────────────────────────────
# Lets the assistant look things up instead of guessing past its training
# cut-off. Brave has a free tier (api.search.brave.com) and is the only real
# web search here; without a key the feature still works but falls back to
# Wikipedia, which needs no key and is good at factual questions.
# Apify's RAG Web Browser returns real Google results with the pages already
# fetched -- the best quality of the three, at about thirteen seconds per
# search, and each call spends Apify credit. Tried first when set.
APIFY_TOKEN=

# Brave is the cheaper alternative but its free tier now requires an active
# plan on file. Tried second.
BRAVE_API_KEY=

# ── Kaggle session control ──────────────────────────────────
# The JSON from kaggle.json, on one line: {"username":"...","key":"..."}
# Lets the app start and stop Kaggle sessions. Without it the Start button is
# hidden rather than shown broken.
KAGGLE_API_TOKEN=
KAGGLE_KERNEL_SLUG=your-kaggle-username/local-llm-gpu-worker
KAGGLE_DATASET_SOURCES=your-kaggle-username/local-llm-worker-code

# ─────────────────────────────────────────────────────────────
#  Worker-side only (NOT needed by the server).
#  On Kaggle these are set as Kaggle Secrets, never committed.
# ─────────────────────────────────────────────────────────────
# ORACLE_WS_URL=wss://chat.example.com/worker/ws
# WORKER_TOKEN=...
# WORKER_NAME=kaggle-t4x2
# MODEL_ID=qwen3-30b-a3b
# MODEL_PATH=/kaggle/input/qwen3-30b-a3b-gguf/Qwen3-30B-A3B-Q4_K_M.gguf
